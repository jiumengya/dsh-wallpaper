{
  "name": "@deepseek-ai/dsh-wallpaper",
  "version": "0.1.0",
  "description": "Wallpaper Engine tools for DeepSeek Harness: list, apply and control wallpapers via the Wallpaper Engine CLI.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
